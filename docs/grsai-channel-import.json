            "script": "// gpt-image-2-vip：仅支持 1K-4K 像素，customParams 已限定合法档位。\nconst body = { model, prompt, images: images || [], aspectRatio: String(params.aspectRatio || \"2048x2048\"), replyType: \"json\" };\nconst data = await request({\n  method: \"post\",\n  url: \"/api/generate\",\n  headers: { \"Content-Type\": \"application/json\", Authorization: `Bearer ${apiKey}` },\n  data: body,\n});\nif (data.status === \"succeeded\" && (data.results || []).length) {\n  const urls = data.results.map((item) => item.url).filter(Boolean);\n  if (urls.length) return urls;\n}\nif (data.status === \"running\" && data.id) {\n  try {\n    return await poll(\n      () => request({ method: \"get\", url: `/api/generate/query?id=${encodeURIComponent(data.id)}`, headers: { Authorization: `Bearer ${apiKey}` } }),\n      (state) => state.status === \"succeeded\" ? (state.results || []).map((item) => item.url).filter(Boolean) : null,\n      { intervalMs: 2500, timeoutMs: 300000 },\n    );\n  } catch (error) {\n    if (String(error.message || \"\").includes(\"404\")) throw new Error(\"async 查询端点未配置，请使用 replyType=json 同步模式\");\n    throw error;\n  }\n}\nthrow new Error(data.error || `生成失败：status=${data.status}`);"
